{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": true,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["npm run typecheck", "npm run build"],
    "after:release": "echo \"Successfully released v${version}! GitHub Actions will now build and attach platform binaries.\""
  }
}
